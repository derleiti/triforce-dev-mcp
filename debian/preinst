#!/bin/sh
set -eu

LOCAL_UNIT=/etc/systemd/system/triforce.service
MIGRATION_DIR=/var/lib/triforce/package-runtime/migration
BACKUP_UNIT="$MIGRATION_DIR/source-service.backup"
MARKER="$MIGRATION_DIR/restore-source-service"

# Migration from legacy packages that owned /etc/systemd/system/triforce.service.
# If the operator-selected source checkout is active, dpkg may remove that old
# package-owned file while unpacking the new package. Save it before unpack so
# postinst can put the operator choice back exactly as it was.
if [ -f "$LOCAL_UNIT" ]; then
    if grep -Fq '/home/zombie/triforce/scripts/start-triforce.sh' "$LOCAL_UNIT" 2>/dev/null; then
        install -d -m 0750 "$MIGRATION_DIR"
        cp -a "$LOCAL_UNIT" "$BACKUP_UNIT"
        : > "$MARKER"
        chmod 0600 "$MARKER"
        echo "Preserving operator-selected TriForce source service across package upgrade."
    fi
fi

#DEBHELPER#
exit 0
