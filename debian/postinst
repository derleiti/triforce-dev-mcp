#!/bin/sh
set -eu

ROOT=/opt/triforce
VENV="$ROOT/.venv"
REQ="$ROOT/requirements.txt"
STATE=/var/lib/triforce
PACKAGE_STATE="$STATE/package-runtime"
REQ_HASH="$PACKAGE_STATE/.requirements.sha256"
MIGRATION_DIR="$PACKAGE_STATE/migration"
BACKUP_UNIT="$MIGRATION_DIR/source-service.backup"
RESTORE_MARKER="$MIGRATION_DIR/restore-source-service"
RUNNING_MARKER="$MIGRATION_DIR/source-service.was-running"
ENABLED_MARKER="$MIGRATION_DIR/source-service.was-enabled"
LOCAL_UNIT=/etc/systemd/system/triforce.service
SOURCE_MODE_MARKER=/etc/triforce/source-mode.enabled
LEGACY_PRERM_BROKE_STATE=0
case "${2:-}" in
    2.86.0-1|1:2.86.0-1) LEGACY_PRERM_BROKE_STATE=1 ;;
esac

# Legacy 2.86.0 packages stopped and disabled triforce.service unconditionally
# from their prerm during upgrades. Restore an operator-selected source unit and
# only the runtime state that was explicitly active/enabled before that prerm.
# This runs before runtime-init so the helper sees source mode and cannot take
# ownership of source-managed configuration/state trees during migration.
if [ -f "$RESTORE_MARKER" ] && [ -f "$BACKUP_UNIT" ]; then
    install -m 0644 "$BACKUP_UNIT" "$LOCAL_UNIT"
    [ -d /etc/triforce ] || install -d -m 0755 /etc/triforce
    printf 'source
' > "$SOURCE_MODE_MARKER"
    chmod 0644 "$SOURCE_MODE_MARKER"
    systemctl daemon-reload || true

    if [ -f "$ENABLED_MARKER" ] || [ "$LEGACY_PRERM_BROKE_STATE" -eq 1 ]; then
        if ! systemctl enable triforce.service >/dev/null 2>&1; then
            echo "WARNING: could not restore enabled state for TriForce source service" >&2
        fi
    fi
    if { [ -f "$RUNNING_MARKER" ] || [ "$LEGACY_PRERM_BROKE_STATE" -eq 1 ]; } &&
       ! systemctl is-active --quiet triforce.service; then
        if ! systemctl start triforce.service; then
            echo "WARNING: could not restore running state for TriForce source service" >&2
        fi
    fi

    rm -f "$RESTORE_MARKER" "$RUNNING_MARKER" "$ENABLED_MARKER"
    echo "Restored operator-selected TriForce source service state."
fi

/usr/lib/triforce/triforce-admin-helper runtime-init
/usr/lib/triforce/triforce-admin-helper config-init

if [ ! -x "$VENV/bin/python" ]; then
    echo "Creating TriForce virtual environment..."
    python3 -m venv "$VENV"
fi

new_hash="$(sha256sum "$REQ" | awk '{print $1}')"
old_hash=""
[ ! -f "$REQ_HASH" ] || old_hash="$(cat "$REQ_HASH" 2>/dev/null || true)"

if [ "$new_hash" != "$old_hash" ] || ! "$VENV/bin/python" -m pip check >/dev/null 2>&1; then
    echo "Synchronizing TriForce Python dependencies..."
    "$VENV/bin/python" -m pip install --disable-pip-version-check --upgrade pip
    "$VENV/bin/python" -m pip install --disable-pip-version-check -r "$REQ"
    "$VENV/bin/python" -m pip check
    printf '%s\n' "$new_hash" > "$REQ_HASH"
    chown triforce:triforce "$REQ_HASH"
    chmod 0640 "$REQ_HASH"
fi

systemctl daemon-reload || true

# Normal package upgrades are file-only. The conditional start/enable above is
# migration repair only and is gated by state captured before a legacy prerm.
#DEBHELPER#
exit 0
