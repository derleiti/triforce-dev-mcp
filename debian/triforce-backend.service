[Unit]
Description=TriForce Multi-LLM Backend
After=network-online.target redis-server.service
Wants=network-online.target

[Service]
RuntimeDirectory=triforce
RuntimeDirectoryMode=0750
Type=simple
User=zombie
Group=zombie
WorkingDirectory=/opt/triforce
EnvironmentFile=-/opt/triforce/config/triforce.env
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/opt/triforce/scripts/setup-venv.sh
ExecStart=/opt/triforce/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 9000 --workers 2 --proxy-headers --forwarded-allow-ips=*
Restart=always
RestartSec=5
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=triforce

[Install]
WantedBy=multi-user.target
