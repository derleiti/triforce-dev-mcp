[Unit]
Description=TriForce bounded local memory summary worker
After=triforce.service ollama.service triforce-claude-mem.service
Wants=ollama.service
[Service]
Type=simple
User=zombie
Group=zombie
WorkingDirectory=/home/zombie/workspace/triforce
Environment=PYTHONPATH=/home/zombie/workspace/triforce
EnvironmentFile=-/home/zombie/workspace/triforce/config/triforce.env
ExecStart=/home/zombie/workspace/triforce/.venv/bin/python -m app.services.local_memory_queue
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
[Install]
WantedBy=multi-user.target
