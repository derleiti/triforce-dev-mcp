post_install() {
  /usr/lib/triforce/triforce-admin-helper runtime-init || return 1
  /usr/lib/triforce/triforce-admin-helper config-init || return 1
  systemctl daemon-reload 2>/dev/null || true
  echo 'TriForce installed. Configure /etc/triforce/triforce.env, then enable/start triforce.service when ready.'
}

post_upgrade() {
  post_install
}

pre_remove() {
  systemctl stop triforce.service 2>/dev/null || true
  systemctl disable triforce.service 2>/dev/null || true
}

post_remove() {
  systemctl daemon-reload 2>/dev/null || true
}
