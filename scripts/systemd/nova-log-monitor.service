[Unit]
Description=Nova Log Monitor - global system log watcher
Documentation=https://ailinux.me/docs/triforce
After=network-online.target triforce.service
Wants=network-online.target

[Service]
Type=simple
User=zombie
Group=zombie
WorkingDirectory=/home/zombie/workspace/triforce
EnvironmentFile=/etc/nova/log-monitor.env
ExecStart=/home/zombie/workspace/triforce/.venv/bin/python /home/zombie/workspace/triforce/scripts/tools/nova_log_monitor.py
StateDirectory=nova-log-monitor
StateDirectoryMode=0750
Restart=on-failure
RestartSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nova-log-monitor

[Install]
WantedBy=multi-user.target
