# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# TRIFORCE BACKEND SERVICE
# Gilt für Master UND Hub-Nodes. Installation via install.sh
# oder: sudo install -m 644 triforce.service /etc/systemd/system/
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[Unit]
Description=TriForce AI Backend Server
Documentation=https://ailinux.me/docs/triforce
After=network-online.target redis-server.service ollama.service docker.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5
# KEIN Requires=docker.service — Hub-Nodes laufen ohne Docker

[Service]
Type=simple
User=zombie
Group=zombie
WorkingDirectory=/home/zombie/triforce
Environment="PATH=/home/zombie/.local/bin:/usr/local/bin:/usr/bin:/bin"
Environment="TRIFORCE_DIR=/home/zombie/triforce"
Environment="TRIFORCE_AUTO_UPDATE=0"
EnvironmentFile=-/home/zombie/triforce/config/triforce.env

# Laufzeit-Workspace. Die App legt darunter selbst Unterordner an
# (agents, prompts, ...), deshalb muss das ELTERNverzeichnis zombie gehoeren.
# '+' = als root ausgefuehrt, User=zombie darf unter /var nichts anlegen.
ExecStartPre=+/usr/bin/install -d -o zombie -g zombie -m 755 /var/tristar

# Persistenter App-State fuer Notifications, TLA-Workflows und Agent-Routing.
# systemd legt /var/lib/triforce mit User/Group des Services an.
StateDirectory=triforce
StateDirectoryMode=0750
RuntimeDirectory=triforce
RuntimeDirectoryMode=0750

ExecStart=/home/zombie/triforce/scripts/start-triforce.sh

ExecStop=/bin/kill -SIGTERM $MAINPID
TimeoutStopSec=30

Restart=on-failure
RestartSec=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=triforce

NoNewPrivileges=false
ProtectSystem=false
PrivateTmp=false

[Install]
WantedBy=multi-user.target
