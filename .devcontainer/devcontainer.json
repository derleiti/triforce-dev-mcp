{
  "name": "TriForce Dev",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "features": {},
  "forwardPorts": [9000, 6379],
  "portsAttributes": {
    "9000": {
      "label": "TriForce API",
      "onAutoForward": "notify"
    },
    "6379": {
      "label": "Redis",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "python -m pip install -r requirements.txt && pre-commit install || true"
}
